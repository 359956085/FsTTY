{
  "version": 2,
  "enabled": true,
  "mode": "allow",
  "allowRules": [
    { "matchType": "exact", "pattern": "pwd" },
    { "matchType": "exact", "pattern": "whoami" },
    { "matchType": "exact", "pattern": "id" },
    { "matchType": "exact", "pattern": "hostname" },
    { "matchType": "exact", "pattern": "hostname -f" },
    { "matchType": "exact", "pattern": "hostnamectl" },
    { "matchType": "exact", "pattern": "uname -a" },
    { "matchType": "exact", "pattern": "uptime" },
    { "matchType": "exact", "pattern": "date -Is" },
    { "matchType": "exact", "pattern": "timedatectl status" },
    { "matchType": "exact", "pattern": "w" },
    { "matchType": "exact", "pattern": "who" },
    { "matchType": "exact", "pattern": "last -n 20" },
    { "matchType": "exact", "pattern": "free -h" },
    { "matchType": "exact", "pattern": "df -h" },
    { "matchType": "exact", "pattern": "df -i" },
    { "matchType": "exact", "pattern": "ls" },
    { "matchType": "exact", "pattern": "ls -la" },
    { "matchType": "exact", "pattern": "lsblk" },
    { "matchType": "exact", "pattern": "lsblk -f" },
    { "matchType": "exact", "pattern": "mount" },
    { "matchType": "exact", "pattern": "ip addr show" },
    { "matchType": "exact", "pattern": "ip route show" },
    { "matchType": "exact", "pattern": "ss -lntup" },
    { "matchType": "exact", "pattern": "ps aux" },
    { "matchType": "exact", "pattern": "ps -ef" },
    { "matchType": "exact", "pattern": "top -b -n 1" },
    { "matchType": "exact", "pattern": "vmstat 1 5" },
    { "matchType": "exact", "pattern": "iostat -xz 1 3" },
    { "matchType": "exact", "pattern": "systemctl --failed" },
    { "matchType": "exact", "pattern": "systemctl list-units --type=service --state=running --no-pager" },
    { "matchType": "exact", "pattern": "journalctl -p err -n 100 --no-pager" },
    { "matchType": "exact", "pattern": "journalctl --disk-usage" },
    { "matchType": "exact", "pattern": "dmesg --level=err,warn" },
    { "matchType": "exact", "pattern": "docker ps" },
    { "matchType": "exact", "pattern": "docker ps -a" },
    { "matchType": "exact", "pattern": "docker stats --no-stream" },
    { "matchType": "exact", "pattern": "podman ps" },
    { "matchType": "exact", "pattern": "kubectl get nodes" },
    { "matchType": "exact", "pattern": "kubectl get pods -A" },
    { "matchType": "exact", "pattern": "git status" },
    { "matchType": "exact", "pattern": "git status --short" },
    { "matchType": "exact", "pattern": "git log -n 20 --oneline" }
  ],
  "excludeRules": [
    { "matchType": "glob", "pattern": "rm *" },
    { "matchType": "glob", "pattern": "sudo rm *" },
    { "matchType": "glob", "pattern": "*/rm *" },
    { "matchType": "glob", "pattern": "*;rm *" },
    { "matchType": "glob", "pattern": "*; rm *" },
    { "matchType": "glob", "pattern": "*&&rm *" },
    { "matchType": "glob", "pattern": "*&& rm *" },
    { "matchType": "glob", "pattern": "*||rm *" },
    { "matchType": "glob", "pattern": "*|| rm *" },
    { "matchType": "glob", "pattern": "mkfs*" },
    { "matchType": "glob", "pattern": "sudo mkfs*" },
    { "matchType": "glob", "pattern": "*/mkfs*" },
    { "matchType": "glob", "pattern": "dd *" },
    { "matchType": "glob", "pattern": "sudo dd *" },
    { "matchType": "glob", "pattern": "fdisk *" },
    { "matchType": "glob", "pattern": "parted *" },
    { "matchType": "glob", "pattern": "wipefs *" },
    { "matchType": "glob", "pattern": "shred *" },
    { "matchType": "glob", "pattern": "truncate *" },
    { "matchType": "glob", "pattern": "chmod -R *" },
    { "matchType": "glob", "pattern": "sudo chmod -R *" },
    { "matchType": "glob", "pattern": "chown -R *" },
    { "matchType": "glob", "pattern": "sudo chown -R *" },
    { "matchType": "glob", "pattern": "shutdown*" },
    { "matchType": "glob", "pattern": "sudo shutdown*" },
    { "matchType": "glob", "pattern": "reboot*" },
    { "matchType": "glob", "pattern": "sudo reboot*" },
    { "matchType": "glob", "pattern": "poweroff*" },
    { "matchType": "glob", "pattern": "halt*" },
    { "matchType": "exact", "pattern": "init 0" },
    { "matchType": "exact", "pattern": "init 6" },
    { "matchType": "glob", "pattern": "systemctl stop *" },
    { "matchType": "glob", "pattern": "systemctl disable *" },
    { "matchType": "glob", "pattern": "systemctl mask *" },
    { "matchType": "glob", "pattern": "systemctl isolate *" },
    { "matchType": "glob", "pattern": "service * stop" },
    { "matchType": "glob", "pattern": "kill -9 *" },
    { "matchType": "glob", "pattern": "pkill *" },
    { "matchType": "glob", "pattern": "killall *" },
    { "matchType": "glob", "pattern": "userdel *" },
    { "matchType": "glob", "pattern": "groupdel *" },
    { "matchType": "glob", "pattern": "usermod *" },
    { "matchType": "glob", "pattern": "passwd *" },
    { "matchType": "exact", "pattern": "visudo" },
    { "matchType": "glob", "pattern": "iptables *" },
    { "matchType": "glob", "pattern": "nft *" },
    { "matchType": "exact", "pattern": "ufw disable" },
    { "matchType": "glob", "pattern": "ip addr flush *" },
    { "matchType": "glob", "pattern": "ip route flush *" },
    { "matchType": "glob", "pattern": "ip link delete *" },
    { "matchType": "glob", "pattern": "apt remove *" },
    { "matchType": "glob", "pattern": "apt purge *" },
    { "matchType": "glob", "pattern": "apt-get remove *" },
    { "matchType": "glob", "pattern": "apt-get purge *" },
    { "matchType": "glob", "pattern": "yum remove *" },
    { "matchType": "glob", "pattern": "dnf remove *" },
    { "matchType": "glob", "pattern": "rpm -e *" },
    { "matchType": "glob", "pattern": "dpkg --purge *" },
    { "matchType": "glob", "pattern": "docker rm *" },
    { "matchType": "glob", "pattern": "docker rmi *" },
    { "matchType": "glob", "pattern": "docker kill *" },
    { "matchType": "glob", "pattern": "docker system prune*" },
    { "matchType": "glob", "pattern": "docker volume rm *" },
    { "matchType": "glob", "pattern": "docker volume prune*" },
    { "matchType": "glob", "pattern": "docker compose down*" },
    { "matchType": "glob", "pattern": "podman rm *" },
    { "matchType": "glob", "pattern": "podman rmi *" },
    { "matchType": "glob", "pattern": "podman system prune*" },
    { "matchType": "glob", "pattern": "kubectl delete *" },
    { "matchType": "glob", "pattern": "kubectl drain *" },
    { "matchType": "glob", "pattern": "helm uninstall *" },
    { "matchType": "glob", "pattern": "git reset --hard*" },
    { "matchType": "glob", "pattern": "git clean -f*" },
    { "matchType": "glob", "pattern": "git push --force*" },
    { "matchType": "glob", "pattern": "git branch -D *" },
    { "matchType": "glob", "pattern": "curl *|*sh*" },
    { "matchType": "glob", "pattern": "curl *|*bash*" },
    { "matchType": "glob", "pattern": "wget *|*sh*" },
    { "matchType": "glob", "pattern": "wget *|*bash*" },
    { "matchType": "glob", "pattern": "*DROP DATABASE*" },
    { "matchType": "glob", "pattern": "*DROP TABLE*" },
    { "matchType": "glob", "pattern": "*TRUNCATE TABLE*" },
    { "matchType": "glob", "pattern": "*drop database*" },
    { "matchType": "glob", "pattern": "*drop table*" },
    { "matchType": "glob", "pattern": "*truncate table*" },
    { "matchType": "glob", "pattern": "*FLUSHALL*" },
    { "matchType": "glob", "pattern": "*FLUSHDB*" },
    { "matchType": "glob", "pattern": "*flushall*" },
    { "matchType": "glob", "pattern": "*flushdb*" },
    { "matchType": "glob", "pattern": "etcdctl del *" },
    { "matchType": "exact", "pattern": ":(){ :|:& };:" },
    { "matchType": "glob", "pattern": "stress *" },
    { "matchType": "glob", "pattern": "stress-ng *" }
  ]
}
