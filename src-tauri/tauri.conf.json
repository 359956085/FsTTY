{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FsTTY",
  "version": "1.7.2",
  "identifier": "com.fengshi.fstty",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "FsTTY",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 720,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "vendor/clink-1.9.34/build.ps1": "third-party/clink/build.ps1",
      "vendor/clink-1.9.34/LICENSE": "third-party/clink/LICENSE",
      "vendor/clink-1.9.34/README.md": "third-party/clink/README.md",
      "vendor/clink-1.9.34/isolation.patch": "third-party/clink/isolation.patch",
      "vendor/clink-1.9.34/source.zip": "third-party/clink/source.zip",
      "vendor/clink-1.9.34/manifest.json": "third-party/clink/manifest.json",
      "src/services/local_terminal_service/highlight/clink.lua": "third-party/clink/fstty/clink.lua",
      "src/services/local_terminal_service/highlight/clink_settings": "third-party/clink/fstty/clink_settings",
      "src/services/local_terminal_service/highlight/inputrc": "third-party/clink/fstty/inputrc",
      "src/services/local_terminal_service/highlight/powershell.ps1": "third-party/clink/fstty/powershell.ps1"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5MzlGRTlCN0M4NUI2NjIKUldSaXRvVjhtLzQ1NmZGZFdxalJZeWRqUXJxS2pETm8zellkYmlxbnU0Sy9GbEpZbkhVZm1LVkoK",
      "endpoints": [
        "https://github.com/359956085/FsTTY/releases/latest/download/latest.json",
        "https://f.qkw.io/fstty/updater/latest.json"
      ]
    }
  }
}
